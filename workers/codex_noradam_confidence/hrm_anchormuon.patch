--- a/config/cfg_pretrain.yaml
+++ b/config/cfg_pretrain.yaml
@@ -27,5 +27,17 @@ beta2: 0.95
 weight_decay: 0.1
 puzzle_emb_weight_decay: 0.1
 
+# Model optimizer. `adam_atan2` is the HRM baseline; `anchormuon` swaps only
+# the dense model-parameter optimizer and leaves sparse puzzle embeddings on
+# CastedSparseEmbeddingSignSGD_Distributed.
+optimizer: adam_atan2
+anchormuon_row_gamma: 0.35
+anchormuon_pmuoneq_beta: 0.90
+anchormuon_normuon_beta2: 0.93
+anchormuon_fallback_lr_scale: 1.0
+anchormuon_soda_lambda_scale: 1.0
+anchormuon_soda_lambda_power: 1.0
+anchormuon_min_matrix_dim: 2
+
 # Hyperparams - Puzzle embeddings training
 puzzle_emb_lr: 1e-2
