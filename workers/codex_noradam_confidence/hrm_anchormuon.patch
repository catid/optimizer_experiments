+class AdamATan2Reference(Optimizer):
+    """Torch reference fallback for the AdamATan2 baseline.
+
+    The official `adam-atan2` package is a thin Python wrapper over a fused CUDA
+    extension. Some local Python 3.12/nightly-CUDA installs expose the wrapper
+    but not `adam_atan2_backend`; this class keeps the same update equation so
+    quality comparisons can still run. It is not a fused speed baseline.
+    """
+
+    def __init__(
+        self,
+        params: ParamsT,
+        lr: Union[float, Tensor] = 1e-3,
+        betas: Tuple[float, float] = (0.9, 0.999),
+        weight_decay: float = 1e-2,
+    ):
+        if not 0.0 <= lr:
+            raise ValueError(f"Invalid learning rate: {lr}")
+        if not 0.0 <= betas[0] < 1.0:
+            raise ValueError(f"Invalid beta parameter at index 0: {betas[0]}")
+        if not 0.0 <= betas[1] < 1.0:
+            raise ValueError(f"Invalid beta parameter at index 1: {betas[1]}")
+        if not 0.0 <= weight_decay:
+            raise ValueError(f"Invalid weight_decay value: {weight_decay}")
+        super().__init__(params, dict(lr=lr, betas=betas, weight_decay=weight_decay))
+
+    @torch.no_grad()
+    def step(self):
+        for group in self.param_groups:
+            lr = group["lr"]
+            if isinstance(lr, Tensor):
+                lr = float(lr.item())
+            if lr == 0:
+                continue
+
+            beta1, beta2 = group["betas"]
+            weight_decay = group["weight_decay"]
+
+            for p in group["params"]:
+                if p.grad is None:
+                    continue
+                if p.grad.is_sparse:
+                    raise RuntimeError("AdamATan2Reference does not support sparse gradients")
+
+                state = self.state[p]
+                if len(state) == 0:
+                    state["step"] = torch.zeros((), dtype=torch.float32, device=p.device)
+                    state["exp_avg"] = torch.zeros_like(p, memory_format=torch.preserve_format)
+                    state["exp_avg_sq"] = torch.zeros_like(p, memory_format=torch.preserve_format)
+
+                step_t = state["step"]
+                exp_avg = state["exp_avg"]
+                exp_avg_sq = state["exp_avg_sq"]
+
+                step_t.add_(1)
+                step = int(step_t.item())
+                step_size = lr / (1 - beta1 ** step)
+                wd_step_size = lr * weight_decay
+                bias_correction2_sqrt = math.sqrt(1 - beta2 ** step)
+
+                orig_dtype = p.dtype
+                if orig_dtype == torch.float64:
+                    p_math = p
+                    grad = p.grad
+                    m = exp_avg
+                    v = exp_avg_sq
+                else:
+                    p_math = p.float()
+                    grad = p.grad.float()
+                    m = exp_avg.float()
+                    v = exp_avg_sq.float()
+
+                p_math.mul_(1 - wd_step_size)
+                m.lerp_(grad, 1 - beta1)
+                v.mul_(beta2).addcmul_(grad, grad, value=1 - beta2)
+                denom = v.sqrt() / bias_correction2_sqrt
+                p_math.add_(torch.atan2(m, denom), alpha=-step_size)
+
+                if orig_dtype != torch.float64:
+                    p.copy_(p_math.to(orig_dtype))
+                    exp_avg.copy_(m.to(orig_dtype))
+                    exp_avg_sq.copy_(v.to(orig_dtype))
+
+
+def _load_adam_atan2():
+    try:
+        from adam_atan2 import AdamATan2
+        return AdamATan2
+    except ModuleNotFoundError as exc:
+        if exc.name != "adam_atan2_backend":
+            raise
+        print(
+            "[HRM AnchorMuon patch] adam_atan2_backend is unavailable; "
+            "using exact torch AdamATan2Reference fallback for baseline quality runs."
+        )
+        return AdamATan2Reference
+
+
+def _load_anchor_muon():
+    optimizer_path = os.environ.get("ANCHORMUON_OPTIMIZER_PATH")
+    if optimizer_path:
+        path = Path(optimizer_path).expanduser().resolve()
+        if not path.exists():
+            raise FileNotFoundError(f"ANCHORMUON_OPTIMIZER_PATH does not exist: {path}")
+        sys.path.insert(0, str(path.parent))
+        from optimizer import AnchorMuon
+        return AnchorMuon
+
+    here = Path(__file__).resolve()
+    for parent in here.parents:
+        candidate = parent / "optimizer.py"
+        if candidate.exists():
+            sys.path.insert(0, str(parent))
+            from optimizer import AnchorMuon
+            return AnchorMuon
+
+    raise ImportError(
+        "Could not locate AnchorMuon optimizer.py. Set ANCHORMUON_OPTIMIZER_PATH=/path/to/optimizer.py."
+    )
+
